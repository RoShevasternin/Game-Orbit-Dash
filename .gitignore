# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Android Profiling
*.hprof

# Сирі записи з телефона (market/content/source/footage) — десятки МБ на файл,
# GitHub блокує >100 МБ. Лежать локально; у git ідуть лише логи подій і готові ролики.
market/content/source/footage/*.mp4
!market/content/source/footage/*.log

# Сміття macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Ключі підпису й зібрані бандли — не в репозиторій (він публічний)
*.jks
*.keystore
keystore.properties
*.aab
