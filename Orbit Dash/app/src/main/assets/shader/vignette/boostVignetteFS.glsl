#ifdef GL_ES
precision mediump float;
#endif

// ─────────────────────────────────────────────────────────────────────────────
// BOOST VIGNETTE — кольоровий край буста І його кільця В ОДНОМУ проході.
//
// Край і так малюється повноекранним квадом, поки діє буст. Кільця, порахова́ні
// тут же, не додають ані draw call, ані жодного зайвого пікселя заливки — лише
// кілька рядків ALU на пікселях, які вже обробляються. Саме тому це дешевше за
// окремі квади на кожне кільце й за ShapeDrawer, який платить CPU за вершини.
//
// Кільце аналітичне: |dist − r| < th/2 зі згладженням. Тобто воно кругле на
// будь-якому радіусі, без поняття «кількість сторін».
//
// ДВА ЦЕНТРИ. Градієнт іде від центру ЕКРАНА, кільця — від центру ОРБІТИ, тому
// u_ringC задає зсув центру кілець у тих самих одиницях, що й d (частки
// зовнішнього радіуса).
// ─────────────────────────────────────────────────────────────────────────────

varying vec4 v_color;      // колір/альфа актора: колір буста × сила огинаючої
varying vec2 v_localUV;    // 0..1 у межах квада (дає BATCH_VERT)

uniform float u_inner;     // частка радіуса, де край ще нульовий
uniform float u_midA;      // альфа у вузлі 0.55
uniform float u_edgeA;     // множник краю (0 — лише кільця)

uniform vec2  u_ringC;     // центр кілець відносно центру квада, у частках радіуса
uniform vec3  u_ring0;     // x = радіус, y = товщина, z = альфа  (частки радіуса)
uniform vec3  u_ring1;
uniform vec3  u_ring2;
uniform vec3  u_ringTint;  // колір кілець: у SLOW-MO гребінь світліший за край
uniform float u_aa;        // згладжування, у частках радіуса (fwidth у GLES 2 — розширення)

/** Згладжене покриття кільця радіуса r товщиною th на відстані d. */
float ring(float d, vec3 spec) {
    if (spec.z <= 0.0) return 0.0;
    float halfW = spec.y * 0.5;
    return (1.0 - smoothstep(halfW - u_aa, halfW + u_aa, abs(d - spec.x))) * spec.z;
}

void main() {
    vec2  p = (v_localUV - vec2(0.5)) * 2.0;   // 1 на вписаному колі квада
    float d = length(p);

    // ── край: ті самі дві лінійні ділянки з вузлом 0.55, що й у запеченій ──
    float s = clamp((d - u_inner) / max(1e-4, 1.0 - u_inner), 0.0, 1.0);
    float edge = s < 0.55
        ? u_midA * (s / 0.55)
        : u_midA + (1.0 - u_midA) * ((s - 0.55) / 0.45);
    edge *= u_edgeA;

    // ── кільця: один і той самий піксель, лише ще трохи ALU ──
    float dr = length(p - u_ringC);
    float r  = ring(dr, u_ring0) + ring(dr, u_ring1) + ring(dr, u_ring2);

    // Колір: край кольором буста, кільця — своїм тінтом. Внески складаються,
    // як «lighter» у прототипі; колір пікселя — зважене середнє двох шарів.
    float sum = edge + r;
    vec3  rgb = (v_color.rgb * edge + u_ringTint * r) / max(sum, 1e-4);
    float a   = clamp(sum, 0.0, 1.0) * v_color.a;

    gl_FragColor = vec4(rgb, a);
}
