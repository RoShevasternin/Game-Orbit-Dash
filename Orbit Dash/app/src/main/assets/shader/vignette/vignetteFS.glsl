#ifdef GL_ES
precision mediump float;
#endif

// ─────────────────────────────────────────────────────────────────────────────
// VIGNETTE — радіальний профіль альфи від центру квада до його краю.
//
// Той самий градієнт, що createRadialGradient у прототипі: між u_inner і краєм
// альфа росте ДВОМА лінійними ділянками з вузлом на 0.55 —
//   d = u_inner        → 0
//   d = u_inner + 0.55 → u_midA
//   d = 1              → 1
// Так задані обидві віньєтки: постійна чорна (u_midA 0.55, тобто пряма лінія)
// і кольоровий край буста (u_midA 0.3 — довго майже нічого, потім швидко).
//
// Колір і загальну альфу дає ТІНТ АКТОРА (v_color): один запечений квад
// обслуговує і чорну базу, і всі три кольори бустів.
// ─────────────────────────────────────────────────────────────────────────────

varying vec4 v_color;      // колір/альфа актора
varying vec2 v_localUV;    // 0..1 у межах регіону (дає BATCH_VERT)

uniform float u_inner;     // частка радіуса, де альфа ще нуль
uniform float u_midA;      // альфа у вузлі 0.55

void main() {
    // 1 на краю вписаного кола квада — тому квад завжди 2 × зовнішній радіус
    float d = length(v_localUV - vec2(0.5)) * 2.0;

    float s = clamp((d - u_inner) / max(1e-4, 1.0 - u_inner), 0.0, 1.0);
    float a = s < 0.55
        ? u_midA * (s / 0.55)
        : u_midA + (1.0 - u_midA) * ((s - 0.55) / 0.45);

    gl_FragColor = vec4(v_color.rgb, v_color.a * a);
}
