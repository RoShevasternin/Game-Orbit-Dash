// highp критично: хеш зір рахується з великих чисел, а на mediump
// (10-11 біт мантиси) значення квантуються — і зорі шикуються в колони.
#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif

// ─────────────────────────────────────────────────────────────────────────────
// STAR FIELD — процедурне зоряне небо на весь екран.
//
// Простір ділиться на клітинки, у кожній рівно одна зоря. Її параметри
// (позиція в клітинці, яскравість, розмір, фаза мерехтіння, період життя)
// виводяться з хешу номера клітинки — зорі не зберігаються, а обчислюються.
// Поле нескінченне, памʼяті нуль, «кількість» зір не впливає на швидкість.
//
// Три шари з різною щільністю і швидкістю дрейфу дають паралакс.
// ─────────────────────────────────────────────────────────────────────────────

varying vec4 v_color;      // колір/альфа актора — фейди працюють самі
varying vec2 v_localUV;    // 0..1 у межах регіону (дає BATCH_VERT)

uniform float u_time;      // глобальний ShaderClock — мерехтіння і цикли життя
uniform float u_aspect;    // width/height — щоб клітинки були квадратні
uniform float u_density;   // к-сть клітинок по висоті
uniform float u_drift;     // НАКОПИЧЕНА фаза дрейфу (не час × швидкість!)
uniform float u_twinkle;   // сила мерехтіння 0..1
uniform float u_stretch;   // 1 = крапки; >1 = смуги вздовж руху (warp)

// Імпульс від тапу: кільцева хвиля розштовхує зорі й затухає
uniform vec2  u_ripplePos;     // центр у localUV (0..1)
uniform float u_rippleRadius;  // поточний радіус хвилі
uniform float u_rippleAmp;     // сила; 0 = ефекту немає
uniform float u_fill;      // частка клітинок із зорею 0..1
uniform vec3  u_colorA;    // основний колір зір
uniform vec3  u_colorB;    // колір рідкісних кольорових зір

// Хеш у стилі iq: тримає числа МАЛИМИ на кожному кроці, тому не розсипається
// на слабкій точності. Саме заміна цього хешу прибирає «колони».
float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Один шар зір.
vec3 starLayer(vec2 uv, float cells, vec2 drift, float sizeMul, float seed) {
    vec2 st = uv * cells + drift * u_drift;
    vec2 id = floor(st) + seed;
    vec2 gv = fract(st) - 0.5;

    // Три НЕЗАЛЕЖНІ випадкові числа (ланцюжок fract() губив би точність)
    float n1 = hash21(id);
    float n2 = hash21(id + 17.31);
    float n3 = hash21(id + 41.77);

    // НЕ в кожній клітинці є зоря. Без цього небо виглядає як рівна сітка
    // з однаковою щільністю — надто «згенеровано».
    float exists = step(1.0 - u_fill, n3);

    // Позиція зорі всередині клітинки — не в центрі, інакше видно сітку
    vec2 pos = (vec2(n1, n2) - 0.5) * 0.74;

    // Розтягування вздовж осі руху: саме воно, а не швидкість, читається як
    // «політ». Крапка, що швидко рухається, виглядає нерухомою; смуга — ні.
    vec2 q = gv - pos;
    q.y /= u_stretch;
    float d = length(q);

    float bright = 0.22 + 0.55 * n3;
    // n2*n2 зміщує розподіл у бік дрібних: великих зір мало, як у справжньому небі
    float radius = (0.012 + 0.026 * n2 * n2) * sizeMul;

    // Мерехтіння: повільне і неглибоке. Частота 0.18–0.62 рад/с → цикл 10–35 с.
    // Справжні зорі не блимають, вони ледь «дихають».
    float tw = 1.0 - u_twinkle * (0.5 + 0.5 * sin(u_time * (0.18 + 0.44 * n2) + n1 * 6.2831));

    // Життєвий цикл: 25–70 с, з них ~85% часу зоря просто світить.
    // Тому згасання/поява трапляються рідко і не привертають уваги.
    float period = 25.0 + 45.0 * n2;
    float ph = fract((u_time + n1 * period) / period);
    float life = smoothstep(0.0, 0.10, ph) * smoothstep(1.0, 0.90, ph);

    float core = smoothstep(radius, 0.0, d);
    float halo = smoothstep(radius * 3.0, 0.0, d) * 0.14;

    float a = (core + halo) * bright * tw * life * exists;

    // ~8% зір беруть колір теми, решта білі
    vec3 col = mix(u_colorA, u_colorB, step(0.92, fract(n1 + n2)));
    return col * a;
}

/**
 * Зсув координати вибірки. Ми не рухаємо зорі — ми зміщуємо ТОЧКУ, з якої
 * читаємо поле. Зоря, що лежала «глибше», проявляється далі від центру, і це
 * читається як розліт. Коли амплітуда згасає, все повертається саме собою —
 * жодного стану зберігати не треба.
 */
vec2 rippleOffset(vec2 uv, vec2 center) {
    if (u_rippleAmp <= 0.0001) return vec2(0.0);

    vec2 d = uv - center;
    float dist = length(d) + 0.0001;

    // Вузьке кільце навколо поточного радіуса — фронт хвилі
    float ring = exp(-pow((dist - u_rippleRadius) * 7.0, 2.0));

    return (d / dist) * (u_rippleAmp * ring);
}

void main() {
    // Аспект-корекція: клітинки квадратні, зорі круглі
    vec2 uv = vec2(v_localUV.x * u_aspect, v_localUV.y);

    vec2 center = vec2(u_ripplePos.x * u_aspect, u_ripplePos.y);
    uv -= rippleOffset(uv, center);

    vec3 c = vec3(0.0);
    // Дрейф ПОМНОЖЕНИЙ на накопичену фазу, а не на час×швидкість: інакше
    // будь-яка зміна швидкості миттєво телепортувала б усе небо.
    // Вектори — у КЛІТИНКАХ на одиницю фази. Клітинка ≈ висота/density,
    // тож 0.09 при density 16 це ≈ 4.5 world-одиниці за секунду при speed = 1:
    // ледь помітний дрейф. При warp (speed ≈ 30) — понад 130 од/с, справжній ривок.
    // ОДИН напрямок на всі шари — різниться лише ШВИДКІСТЬ. Це і є паралакс:
    // близькі зорі проносяться швидше за далекі, але всі летять туди само.
    // Різні напрямки (як було) на warp читаються як хаос, а не як рух.
    c += starLayer(uv, u_density,        vec2( 0.005, -0.029), 0.80,  0.0);
    c += starLayer(uv, u_density * 0.62, vec2( 0.009, -0.047), 1.00, 13.7);
    c += starLayer(uv, u_density * 0.38, vec2( 0.014, -0.078), 1.25, 41.3);

    float a = clamp(max(max(c.r, c.g), c.b), 0.0, 1.0);
    gl_FragColor = vec4(c, a) * v_color;
}
