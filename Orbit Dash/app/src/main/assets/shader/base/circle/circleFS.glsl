#ifdef GL_ES
precision mediump float;
#endif

// ─────────────────────────────────────────────────────────────────────────────
// CIRCLE — коло: заливка і/або обводка, з опційним розмиттям краю.
//
// Вихід ЗАВЖДИ БІЛИЙ — колір дає тінт актора (v_color), як у звичайного Image.
// Роздільності не має: край рахується як знакова відстань, тож коло однаково
// чисте і на 8 юнітів (крапка в гемі), і на 300 (емблема в меню).
//
// РАДІУС. u_radius > 0 — коло саме такого радіуса, а решта квада лишається
// запасом під розмиття. u_radius <= 0 — коло вписується в актора (мінус AA).
//
// РОЗМИТТЯ. u_blur — половина ширини згасання, У КОЖЕН БІК від межі кола, як
// гаус: на самій межі альфа рівно 0.5. Це дає збіг із Layer Blur у Figma при
// u_blur = значення блюру (перевірено чисельно проти гауса).
//
// Малювати за межі квада НЕМОЖЛИВО — його краї це і є площа актора. Тому під
// зовнішню половину розмиття актор мусить бути більшим за коло на 2×blur;
// цим займається ACircle.setCircle().
// ─────────────────────────────────────────────────────────────────────────────

varying vec4 v_color;
varying vec2 v_localUV;

uniform vec2  u_size;         // розмір квада у world-юнітах
uniform float u_radius;       // радіус кола; <= 0 — вписати в актора
uniform float u_aa;           // згладжування
uniform float u_blur;         // 0 = різкий край; >0 — розмиття в обидва боки
uniform float u_fillAlpha;    // 0 = прозорий центр (лишиться тільки обводка)
uniform float u_strokeWidth;  // 0 = без обводки
uniform float u_strokeAlpha;

void main() {
    vec2  p = (v_localUV - 0.5) * u_size;

    // Авторадіус вписуємо в актора з відступом під розмиття (і хоча б під AA),
    // інакше зовнішня половина градієнта обрізалась би краєм квада — і то лише
    // з боків, не по діагоналях, тож світіння виглядало б підрубаним.
    float r = (u_radius > 0.0) ? u_radius : min(u_size.x, u_size.y) * 0.5 - max(u_blur, u_aa);

    // Знакова відстань до кола: <0 усередині, >0 назовні
    float d = length(p) - r;

    // Заливка: згасання симетричне навколо межі, як у гауса
    float f    = max(u_blur, u_aa);
    float fill = (1.0 - smoothstep(-f, f, d)) * u_fillAlpha;

    // Обводка завжди різка й іде ВСЕРЕДИНУ від межі
    float stroke = 0.0;
    if (u_strokeWidth > 0.0001) {
        float edge  = 1.0 - smoothstep(-u_aa, u_aa, d);
        float inner = 1.0 - smoothstep(-u_strokeWidth - u_aa, -u_strokeWidth + u_aa, d);
        stroke = clamp(edge - inner, 0.0, 1.0) * u_strokeAlpha;
    }

    // Обводка НАД заливкою (alpha over), а не max: інакше рамка з меншою
    // альфою за заливку просто зникає замість того, щоб її підсвітити.
    float a = fill + stroke * (1.0 - fill);

    gl_FragColor = vec4(1.0, 1.0, 1.0, a) * v_color;
}
