#ifdef GL_ES
precision mediump float;
#endif

// ─────────────────────────────────────────────────────────────────────────────
// BAR PROGRESS — капсула із заповненням зліва, один прохід.
//
// Лінійний двійник ringProgressFS: доріжка на всю довжину з альфою u_trackA і
// заповнення на u_frac довжини. Обидві смуги — ОДНА фігура в одному квадi,
// тому це один актор і один draw, а не «доріжка + заповнення» двома акторами.
//
// Заповнення — та сама капсула, лише коротша, тож правий кінець у нього
// заокруглений, як у Figma. Коли воно вужче за власну висоту, радіус сам
// стискається до половини ширини — смуга гасне в крапку, а не в пелюстку.
//
// Доріжка й заповнення мають власні кольори: у грі доріжка біла й ледь видима,
// заповнення — кольору активного буста. Складаються в ПРЕМУЛЬТИПЛІКОВАНОМУ
// вигляді й діляться на альфу наприкінці — як у roundRectFS, інакше на межі
// заповнення був би кант не того відтінку.
//
// ТЕКСТУРНИЙ РЕЖИМ (u_useTex = 1): заповнення малює текстура актора,
// натягнута на ВСЮ смугу — прогрес її ПРОЯВЛЯЄ зліва, як шторка, а не тягне
// й не розтягує. u_texTrackA > 0 — доріжка тією ж текстурою, пригашеною.
// Біла 4×4 текстура (звичайний drawerUtil-регіон) робить обидва mix нульовими,
// тож кольоровий режим не платить за семпл нічого, крім самого читання білого.
//
// ДВА СПОСОБИ ПОКАЗАТИ КАРТИНКУ, u_texSlide перемикає:
//   0 — картинка ПРИБИТА до смуги, край заповнення її відкриває (шторка);
//   1 — картинка ЇДЕ: її правий край завжди на краю заповнення, тобто вона
//       «в'їжджає» зліва. Це те саме, що посунути картинку під маскою на
//       x = (frac − 1)·ширина, лише без маски й без FBO.
// Зсув рахується в ЛОКАЛЬНИХ UV регіону (0..1) і клемпиться, тому в атласі
// сусідні спрайти не підмішуються. При u_texSlide = 0 беремо v_texCoords як є
// — шлях старого режиму не змінюється жодною операцією.
//
// Розміри у world-юнітах: радіус 1.5 лишається 1.5 і на 64×3, і на 200×8.
// Радіус клемпиться до половини меншої сторони — як у Figma: більший радіус
// у SDF «з'їдав» би кінці смуги всередину замість чесної капсули.
// ─────────────────────────────────────────────────────────────────────────────

varying vec4 v_color;
varying vec2 v_localUV;
varying vec2 v_texCoords;    // UV регіону в атласі — для текстурного режиму

uniform sampler2D u_texture; // текстура актора; біла 4×4, коли смуга кольорова
uniform vec2  u_size;        // розмір квада у world-юнітах
uniform float u_radius;      // радіус кінців
uniform float u_aa;          // згладжування
uniform float u_frac;        // заповнення 0..1 зліва направо
uniform float u_fillA;       // альфа заповнення
uniform float u_trackA;      // альфа незаповненої частини
uniform vec3  u_trackColor;  // білий = «колір беремо з тінту актора»
uniform vec3  u_fillColor;
uniform float u_useTex;      // 1 — заповнення малює текстура (reveal), 0 — u_fillColor
uniform float u_texTrackA;   // > 0 (лише з u_useTex) — доріжка текстурою з цією альфою
uniform float u_texSlide;    // 1 — картинка їде за краєм заповнення, 0 — прибита
uniform vec2  u_uvMin;       // межі регіону в атласі — ті самі, що бачить BATCH_VERT
uniform vec2  u_uvMax;

// Знакова відстань до заокругленого прямокутника: <0 усередині, >0 назовні
float roundedBox(vec2 p, vec2 halfSize, float r) {
    vec2 q = abs(p) - halfSize + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

void main() {
    vec2 p = (v_localUV - 0.5) * u_size;

    // Клемп як у Figma: радіус не більший за половину меншої сторони
    float r = min(u_radius, min(u_size.x, u_size.y) * 0.5);

    // AA йде ВСЕРЕДИНУ: d = 0 припадає рівно на межу квада, назовні місця немає
    float track = 1.0 - smoothstep(-u_aa, 0.0, roundedBox(p, u_size * 0.5, r));

    // Заповнення: капсула завдовжки u_frac, притиснута до лівого краю
    float f  = clamp(u_frac, 0.0, 1.0);
    float w  = u_size.x * f;
    vec2  hs = vec2(w * 0.5, u_size.y * 0.5);
    vec2  pf = p - vec2(w * 0.5 - u_size.x * 0.5, 0.0);

    float fill = 1.0 - smoothstep(-u_aa, 0.0, roundedBox(pf, hs, min(r, w * 0.5)));
    fill *= step(0.0001, f);                       // нуль — лишається сама доріжка

    // UV картинки: стоять (шторка) або їдуть разом із краєм заповнення.
    // Локальні 0..1 клемпимо, щоб зсув не виліз за межі регіону в атласі.
    vec2 uvSlid = u_uvMin + clamp(v_localUV + vec2(1.0 - f, 0.0), 0.0, 1.0) * (u_uvMax - u_uvMin);
    vec4 tex    = texture2D(u_texture, mix(v_texCoords, uvSlid, u_texSlide));

    vec3  fillRGB = u_fillColor * mix(vec3(1.0), tex.rgb, u_useTex);
    float fillA   = fill * u_fillA * mix(1.0, tex.a, u_useTex);

    float useTT    = u_useTex * step(0.0001, u_texTrackA);
    vec3  trackRGB = mix(u_trackColor, tex.rgb, useTT);
    float trackA   = track * mix(u_trackA, u_texTrackA * tex.a, useTT);

    // Заповнення НАД доріжкою (alpha over), як обводка над заливкою в roundRect
    float a = fillA + trackA * (1.0 - fillA);

    vec3 rgb = fillRGB * fillA + trackRGB * trackA * (1.0 - fillA);
    rgb /= max(a, 0.0001);                         // назад у пряму альфу

    gl_FragColor = vec4(rgb, a) * v_color;
}
