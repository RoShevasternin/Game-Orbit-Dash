<?xml version="1.0" encoding="utf-8"?>
<!--
  res/drawable/ic_notification.xml

  Іконка статус-бара для Orbit Dash.

  Android бере від цієї іконки ТІЛЬКИ альфа-канал: усі кольори відкидаються,
  система заливає силует одним кольором (білим на темній панелі або тим, що
  вказано в accentColor). Тому основна іконка гри тут не підійде в принципі —
  на виході був би суцільний білий квадрат.

  Форма: одне кільце-обведення + залита кулька на ньому. Другого кільця і гема
  немає свідомо — на 24dp вони злипаються в пляму. Кулька винесена за товщину
  кільця (r=3.1 проти 0.85 напівтовщини), щоб силует читався навіть у
  найменшому розмірі: «щось котиться по орбіті».

  Вміст лежить у 22×22 всередині 24×24 — 1dp повітря по краю, як вимагає
  Material: інакше система обріже силует при малюванні.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Орбіта: кільце r=9, товщина 1.7. Обведення, а не заливка -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:fillColor="@android:color/transparent"
        android:pathData="M12,3 A9,9 0 1,1 11.99,3 Z" />

    <!-- Гравець: залита кулька на орбіті, вгору-праворуч (кут -55°) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.16,4.63 m-3.1,0 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0" />

</vector>
